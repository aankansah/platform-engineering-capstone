# ==========================================
# Terraform
# ==========================================

# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config files
.terraformrc
terraform.rc

# Terraform lock file
# Keep this if you're using a team and want consistent provider versions.
# Comment out the next line if you want to commit it.
# .terraform.lock.hcl

# ==========================================
# Environment / Secrets
# ==========================================

.env
.env.*
*.pem
*.key

# ==========================================
# macOS
# ==========================================

.DS_Store

# ==========================================
# VS Code
# ==========================================

.vscode/

# ==========================================
# Logs
# ==========================================

*.log

# ==========================================
# Optional: Ignore plan files
# ==========================================

*.tfplan
plan.out

# ==========================================
# Common build / artifact ignores across services
# ==========================================

# Node
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
coverage/
*.tsbuildinfo

# TypeScript cache
/.tscache

# Environment
*.env.local
env.local

# Logs (already present above, keep explicit)
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
env/
.venv/

